# --- Database ---
# SQLite (default/dev): sqlite:///./neuranet.db
# PostgreSQL (prod):    postgresql+psycopg2://user:password@host:5432/neuranet
DATABASE_URL=sqlite:///./neuranet.db

# --- Auth / JWT ---
# Generate a strong secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Collector ---
# Network interface used for live packet capture (leave blank to use OS default)
COLLECTOR_INTERFACE=
